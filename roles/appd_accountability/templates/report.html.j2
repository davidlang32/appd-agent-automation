<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>AppDynamics Automation Report — {{ acct_run_id }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
         margin: 0; padding: 24px; color: #1c2330; background: #f5f7fa; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: #5b6677; font-size: 13px; margin-bottom: 20px; }
  .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
  .card { background: #fff; border: 1px solid #e1e6ee; border-radius: 8px;
          padding: 14px 18px; min-width: 120px; }
  .card .n { font-size: 26px; font-weight: 700; }
  .card .l { font-size: 12px; color: #5b6677; text-transform: uppercase; letter-spacing: .04em; }
  table { width: 100%; border-collapse: collapse; background: #fff;
          border: 1px solid #e1e6ee; border-radius: 8px; overflow: hidden; }
  th, td { text-align: left; padding: 9px 12px; font-size: 13px; border-bottom: 1px solid #eef1f6; }
  th { background: #eef2f8; font-weight: 600; }
  tr:last-child td { border-bottom: none; }
  .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .changed { background: #fff3cd; color: #8a6d00; }
  .nochange { background: #e6f4ea; color: #1e7a37; }
  .miss { color: #b3261e; font-weight: 600; }
  code { font-size: 12px; color: #3a4150; }
  .files { margin: 4px 0 0; padding-left: 16px; }
  footer { margin-top: 20px; color: #8a93a3; font-size: 11px; }
</style>
</head>
<body>
  <h1>AppDynamics Automation Report</h1>
  <div class="sub">
    Client: <strong>{{ client_name }}</strong> ({{ contract_id }}) &middot;
    Action: <strong>{{ appd_action | default('configure') }}</strong> &middot;
    Run: {{ acct_run_id }} &middot;
    {{ ansible_date_time.iso8601 }}
    {% if ansible_check_mode %}&middot; <em>CHECK MODE (no changes applied)</em>{% endif %}
  </div>

  <div class="cards">
    <div class="card"><div class="n">{{ acct_total_hosts }}</div><div class="l">Hosts</div></div>
    <div class="card"><div class="n">{{ acct_total_records }}</div><div class="l">Agents touched</div></div>
    <div class="card"><div class="n">{{ acct_changed_count }}</div><div class="l">Changed</div></div>
  </div>

  <table>
    <thead>
      <tr><th>Host</th><th>OS</th><th>Agent</th><th>Status</th><th>Managed files</th></tr>
    </thead>
    <tbody>
    {% for r in acct_records | default([]) | sort(attribute='host') %}
      <tr>
        <td>{{ r.host }}</td>
        <td>{{ r.os }}</td>
        <td>{{ r.agent_type }}</td>
        <td>
          {% if r.changed %}<span class="pill changed">changed</span>
          {% else %}<span class="pill nochange">no change</span>{% endif %}
        </td>
        <td>
          <ul class="files">
          {% for f in r.files %}
            <li>
              <code>{{ f.path }}</code>
              {% if not f.exists %}<span class="miss"> — MISSING</span>
              {% else %} <span style="color:#8a93a3">[{{ f.checksum[:10] }}]</span>{% endif %}
            </li>
          {% endfor %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <footer>
    Generated by appd_accountability &middot; full log archived as ansible.log in this run folder.
  </footer>
</body>
</html>
